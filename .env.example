# Required: Gemini API Key (free tier at https://aistudio.google.com) for TTS voice generation
GEMINI_API_KEY=

# Optional: Backup Gemini API Key (automatic failover if daily quota is reached)
GEMINI_API_KEY_2=

# Optional: Postiz Public API Key (https://platform.postiz.com) for automated multi-platform publishing
POSTIZ_API_KEY=

# Optional: Your own channel handle (without @) and display name for scripts/sync_channel.py & notifications
# Also edit src/brand/config.ts to customize the handle, tagline, and avatar rendered inside videos.
CHANNEL_HANDLE=sudoraccoon
CHANNEL_NAME="Sudo the Raccoon"
